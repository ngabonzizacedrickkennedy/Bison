{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".npmrc", "pnpm-lock.yaml", "packages/tsconfig/base.json"],
  "globalEnv": [
    "NODE_OPTIONS",
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE",
    "REQUESTS_CA_BUNDLE",
    "UV_SYSTEM_CERTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**", "*.tsbuildinfo"]
    },
    "codegen": {
      "dependsOn": ["@bison/contracts#build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
