{
  "name": "bison",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "codegen": "turbo run codegen",
    "check:prompts": "pnpm --filter @bison/contracts check:prompts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "py:sync": "node scripts/py.mjs sync",
    "py:lint": "node scripts/py.mjs lint",
    "py:typecheck": "node scripts/py.mjs typecheck",
    "py:test": "node scripts/py.mjs test",
    "verify": "pnpm codegen && pnpm check:prompts && pnpm build && pnpm typecheck && pnpm test && pnpm format:check && pnpm py:sync && pnpm py:lint && pnpm py:typecheck && pnpm py:test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
