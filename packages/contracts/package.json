{
  "name": "@bison/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./generated/bison-contracts.schema.json"
  },
  "scripts": {
    "build": "tsc --build && pnpm run generate:schema",
    "generate:schema": "tsx scripts/generate-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist generated .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bison/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod-to-json-schema": "^3.24.1"
  }
}
